class Solution {
    public boolean DFSColoring(int graph[][],int color[],int idx, int col){
        color[idx] = col;
        for(int adj : graph[idx]){
            if(color[adj] == -1){
                if(!DFSColoring(graph,color,adj,(col+1)%2)) return false;
            }else if(color[adj] == col) return false;
        }
        return true;
        
    }
    public boolean isBipartite(int[][] graph) {
        int n = graph.length;

        int color[] = new int[n];
        for(int i=0;i<n;i++) color[i] = -1;

        for(int i=0;i<n;i++){
            if(color[i] == -1){
                if(!DFSColoring(graph,color,i,0)) return false;
            }
        }
        return true;
    }
}